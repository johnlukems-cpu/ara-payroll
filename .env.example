# PostgreSQL connection string (Vercel: use Neon / Vercel Postgres / Supabase — the pooled URL with ?sslmode=require)
DATABASE_URL="postgresql://ara:ara@localhost:5432/ara_payroll"

# Local document storage (ignored when S3_BUCKET is set)
STORAGE_DIR="./storage"

# S3-compatible document storage — REQUIRED on Vercel (AWS S3, Cloudflare R2, Supabase Storage, ...)
# S3_BUCKET="ara-payroll-documents"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # omit for AWS S3
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Only for testing over plain HTTP (never in production)
# INSECURE_COOKIES="true"
